{
  "name": "dsh-lsp-java",
  "version": "0.1.0",
  "description": "DSH Java 语言插件：注册 java 语言到 dsh-lsp-core 注册表。LSP 服务器复用本机 Eclipse JDTLS（DSH_JAVA_LS_HOME / VS Code redhat.java 扩展），discover 探测 + commandFor 按 root 构造 -data 目录；找不到时 Java 降级纯高亮。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "dsh-lsp-core": "workspace:*",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "dsh-lsp-core": {
      "optional": true
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "cordis": "^4.0.0-rc.7",
    "dsh-lsp-core": "workspace:*",
    "react": "^18.3.1",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "prepare": "pnpm build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "license": "MIT"
}
