{
  "name": "dsh-lsp-core",
  "version": "0.1.0",
  "description": "DSH LSP 基础设施：client 语言注册表（语法包/扩展名）+ LanguageCapability（补全/诊断/签名/悬停/跳转/重命名/格式化/codeAction）+ host 语言服务器注册表与 LSP 桥。供 dsh-ide-layout 编辑器与各语言插件（dsh-lsp-python 等）协作。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "cordis": "^4.0.0-rc.7",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "cordis": {
      "optional": true
    }
  },
  "dependencies": {
    "@codemirror/state": "^6.4.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/ws": "^8.18.1",
    "cordis": "^4.0.0-rc.7",
    "react": "^18.3.1",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "prepare": "pnpm build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "license": "MIT"
}
